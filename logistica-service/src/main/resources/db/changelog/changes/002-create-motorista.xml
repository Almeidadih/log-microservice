<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="002-create-motorista" author="diego">
        <createTable tableName="motorista">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="nome" type="varchar(150)">
                <constraints nullable="false"/>
            </column>
            <column name="cnh" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="transportadora_id" type="uuid">
                <constraints nullable="false" foreignKeyName="fk_motorista_transportadora" references="transportadora(id)"/>
            </column>
        </createTable>
        <createIndex indexName="idx_motorista_transportadora" tableName="motorista">
            <column name="transportadora_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
